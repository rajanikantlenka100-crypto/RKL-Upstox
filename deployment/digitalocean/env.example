# Copy into a protected deployment environment file. Never commit credentials.
EXECUTION_MODE=READ_ONLY
REAL_ORDERS_ENABLED=OFF
AUTO_TRADING_ENABLED=OFF
ORDER_ENV=live
DATABASE_PATH=/var/lib/rkl-upstox/data/readonly.sqlite3
MARKET_OPEN=09:15
MARKET_CLOSE=15:15
LOT_COUNT=1
RAW_MARKET_RETENTION_DAYS=7
TELEMETRY_RETENTION_DAYS=30
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=5
STORAGE_MAINTENANCE_INTERVAL_SECONDS=900
DASHBOARD_HOST=127.0.0.1
DASHBOARD_HEALTH_HOST=127.0.0.1
OPEN_BROWSER=OFF
# Production-only: EXECUTION_MODE=PRODUCTION, REAL_ORDERS_ENABLED=ON,
# UPSTOX_ORDER_IP=<reserved public IP>, and explicit broker credentials.
