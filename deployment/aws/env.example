# Protected Ubuntu 24.04 EC2 environment template.
# Copy to /etc/rkl-upstox/rkl-upstox.env and fill credentials on the host.
EXECUTION_MODE=PRODUCTION
ORDER_ENV=live
REAL_ORDERS_ENABLED=ON
AUTO_TRADING_ENABLED=ON
AUTO_ENTRY_ENABLED=ON
LIVE_BROKER_VALIDATION=ON
MARKET_DATA_MODE=websocket
WEBSOCKET_ENABLED=ON
WEBSOCKET_MODE=full
HISTORICAL_SYNC_ENABLED=ON
INSTRUMENTS=NIFTY,BANKNIFTY,SENSEX,MIDCPNIFTY
MARKET_OPEN=09:15
MARKET_CLOSE=15:15
TIMEFRAME_MINUTES=5
LOT_COUNT=1
UPSTOX_ORDER_IP=CHANGE_ME
DATABASE_PATH=/var/lib/rkl-upstox/data/production.sqlite3
RAW_MARKET_RETENTION_DAYS=7
TELEMETRY_RETENTION_DAYS=30
RAW_MARKET_EVENTS_ENABLED=OFF
RAW_MARKET_MAX_ROWS=250000
TELEMETRY_MAX_ROWS=250000
STORAGE_WARNING_BYTES=5368709120
STORAGE_HARD_LIMIT_BYTES=8589934592
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=5
STORAGE_MAINTENANCE_INTERVAL_SECONDS=900
DASHBOARD_HOST=127.0.0.1
DASHBOARD_HEALTH_HOST=127.0.0.1
DASHBOARD_PORT=8876
MOBILE_WS_HOST=127.0.0.1
MOBILE_WS_PORT=8877
OPEN_BROWSER=OFF
UPSTOX_CLIENT_ID=CHANGE_ME
UPSTOX_CLIENT_SECRET=CHANGE_ME
UPSTOX_ACCESS_TOKEN=CHANGE_ME
UPSTOX_AUTH_CODE=
MOBILE_API_TOKEN=CHANGE_ME
