# Use only with broker-supported Upstox sandbox credentials and endpoint.
EXECUTION_MODE=SANDBOX
REAL_ORDERS_ENABLED=ON
AUTO_TRADING_ENABLED=ON
ORDER_ENV=sandbox
SANDBOX_ACCESS_TOKEN=CHANGE_ME
DATABASE_PATH=data/sandbox.sqlite3
DASHBOARD_HOST=127.0.0.1
DASHBOARD_HEALTH_HOST=127.0.0.1
OPEN_BROWSER=OFF
