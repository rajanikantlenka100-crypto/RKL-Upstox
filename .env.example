# RKL Upstox production environment template.
# Copy to .env and replace every CHANGE_ME value. Never commit .env or tokens.

UPSTOX_CLIENT_ID=CHANGE_ME
UPSTOX_CLIENT_SECRET=CHANGE_ME
UPSTOX_REDIRECT_URI=http://127.0.0.1:8766/callback
UPSTOX_ACCESS_TOKEN=
UPSTOX_AUTH_CODE=
UPSTOX_API_BASE=https://api.upstox.com
UPSTOX_ORDER_BASE=https://api-hft.upstox.com
ORDER_ENV=live
SANDBOX_API_BASE=https://sandbox.upstox.com
SANDBOX_ACCESS_TOKEN=
MARKET_DATA_MODE=websocket
EXECUTION_MODE=READ_ONLY
# Legacy alias accepted during migration: TRADING_MODE=READ_ONLY
AUTO_TRADING_ENABLED=OFF
MANUAL_APPROVAL_ENABLED=ON
WEBSOCKET_ENABLED=ON
WEBSOCKET_MODE=full
HISTORICAL_SYNC_ENABLED=ON
INSTRUMENTS=NIFTY,BANKNIFTY,SENSEX,MIDCPNIFTY

REAL_ORDERS_ENABLED=OFF
LIVE_BROKER_VALIDATION=OFF
UPSTOX_ORDER_IP=
UPSTOX_POLL_SECONDS=1.0
WEBSOCKET_RECONNECT_SECONDS=10
WEBSOCKET_RECONNECT_ATTEMPTS=20
INSTRUMENT_MASTER_URL=https://assets.upstox.com/market-quote/instruments/exchange/complete.json.gz
INSTRUMENT_MASTER_PATH=instrument_master.json
# Leave empty to use the mode-specific data/<mode>.sqlite3 path.
DATABASE_PATH=
TIMEFRAME_MINUTES=5
MARKET_OPEN=09:15
MARKET_CLOSE=15:15
LOT_COUNT=1
RAW_MARKET_RETENTION_DAYS=7
TELEMETRY_RETENTION_DAYS=30
RAW_MARKET_EVENTS_ENABLED=ON
RAW_MARKET_MAX_ROWS=250000
TELEMETRY_MAX_ROWS=250000
STORAGE_WARNING_BYTES=5368709120
STORAGE_HARD_LIMIT_BYTES=8589934592
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=5
STORAGE_MAINTENANCE_INTERVAL_SECONDS=900
REST_SYNC_INTERVAL_SECONDS=7200
HISTORICAL_LOOKBACK_DAYS=10
HISTORICAL_COUNT=100
INTRADAY_RECONCILIATION_ENABLED=ON
CCI_PERIOD=5
RSI_PERIOD=14
RSI_SMA_PERIOD=14
RSI_LOOKBACK_PERIODS=1
SL_BUFFER=1.0
SL_MIN_TICK_DISTANCE=2
SL_LIMIT_OFFSET=2.0
MAX_RISK_PER_TRADE=0
LOT_COUNT=1
STALE_DATA_SECONDS=15
DISPLAY_REFRESH_SECONDS=1.0
SIGNAL_TRACE_ENABLED=ON
SIGNAL_TRACE_PATH=logs/signal_candidate_trace.jsonl
SIGNAL_AUDIT_PATH=logs/signal_audit.jsonl
LIVE_VALIDATION_PATH=logs/live_broker_validation.jsonl
OPEN_BROWSER=OFF
DASHBOARD_HOST=127.0.0.1
DASHBOARD_HEALTH_HOST=127.0.0.1
DASHBOARD_PORT=8765
# Required for authenticated /api/mobile/* access. Generate a long random value.
MOBILE_API_TOKEN=
MOBILE_WS_HOST=127.0.0.1
MOBILE_WS_PORT=8766
